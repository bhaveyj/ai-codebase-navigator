# Copy to .env. Production runs with Docker Compose and real Atlas/Gemini.
NAVIGATOR_MODE=production
MONGODB_URI=
MONGODB_DATABASE=codebase_navigator
REDIS_URL=redis://redis:6379/0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=120
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# All replicas sharing this Gemini project must use the same Redis and ID.
GEMINI_QUOTA_PROJECT=default
GEMINI_QUOTA_FRACTION=0.70
# Set these to the active AI Studio limits; the app admits at most 70%.
GEMINI_EMBEDDING_RPM=100
GEMINI_EMBEDDING_TPM=30000
# Replace with the RPD shown in AI Studio when it has a provider daily limit.
# GEMINI_EMBEDDING_RPD=1000
# Local daily application cap even if provider RPD is unspecified. Source
# inputs and exact token-count preflights both consume this budget.
GEMINI_EMBEDDING_DAILY_BUDGET=700
EMBEDDING_BATCH_SIZE=8
# Count exact Embedding 2 tokens before each new source batch. The preflight
# request is also charged to the shared quota gate, and its result is cached.
GEMINI_COUNT_EMBEDDING_TOKENS=true
EMBEDDING_MAX_INPUTS_PER_LEASE=240
GEMINI_QUERY_RPM_RESERVE=10
GEMINI_QUERY_TPM_RESERVE=3000
GEMINI_QUERY_DAILY_RESERVE=25
GEMINI_ANSWER_RPM=5
GEMINI_ANSWER_TPM=250000
# GEMINI_ANSWER_RPD=100
GEMINI_ANSWER_DAILY_BUDGET=100
GEMINI_ANSWER_MAX_EVIDENCE_CHARS=24000
REPOSITORY_SUBMISSIONS_PER_IP_DAY=2
GITHUB_TOKEN=
# Optional for host development; container paths are set in Compose.
# NAVIGATOR_DATA_DIR=.navigator
# NAVIGATOR_DEMO_DIR=tests/fixtures/shop
# NAVIGATOR_ANALYZER=analyzers/typescript/src/cli.mjs
# NODE_BINARY=node
