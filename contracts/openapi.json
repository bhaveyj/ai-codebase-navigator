              "queued",
              "running",
              "ready",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "graphReady": {
            "type": "boolean",
            "title": "Graphready"
          },
          "ragReady": {
            "type": "boolean",
            "title": "Ragready"
          },
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "counts": {
            "$ref": "#/components/schemas/Counts"
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Languages"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "overview": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Overview"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "repositoryId",
          "repositoryName",
          "commitSha",
          "status",
          "phase",
          "graphReady",
          "ragReady",
          "jobId",
          "counts",
          "languages",
          "createdAt",
          "warnings"
        ],
        "title": "Analysis"
      },
      "AnswerBlock": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "unknown"
            ],
            "title": "Kind"
          },
          "citationIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citationids"
          }
        },
        "type": "object",
        "required": [
          "text",
          "kind",
          "citationIds"
        ],
        "title": "AnswerBlock"
      },
      "Capabilities": {
        "properties": {
          "languages": {
            "items": {
              "$ref": "#/components/schemas/LanguageCapability"
            },
            "type": "array",
            "title": "Languages"
          },
          "services": {
            "$ref": "#/components/schemas/Services"
          },
          "mode": {
            "type": "string",
            "enum": [
              "local",
              "production"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "languages",
          "services",
          "mode"
        ],
        "title": "Capabilities"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "title": "Message",
            "default": ""
          },
          "selectedNodeId": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "title": "Selectednodeid"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryTurn"
            },
            "type": "array",
            "maxItems": 12,
            "title": "History"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "explain",
                  "dependencies",
                  "dependents"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/AnswerBlock"
            },
            "type": "array",
            "title": "Blocks"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "relatedNodeIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Relatednodeids"
          },
          "mode": {
            "type": "string",
            "enum": [
              "rag",
              "graph"
            ],
            "title": "Mode"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "blocks",
          "citations",
          "relatedNodeIds",
          "mode",
          "warnings"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "analysisId": {
            "type": "string",
            "title": "Analysisid"
          },
          "fileId": {
            "type": "string",
            "title": "Fileid"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "commitSha": {
            "type": "string",
            "title": "Commitsha"
          },
          "startLine": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Startline"
          },
          "endLine": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Endline"
          },
          "chunkId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunkid"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "id",
          "analysisId",
          "fileId",
          "path",
          "commitSha",
          "startLine",
          "endLine"
        ],
        "title": "Citation"
      },
      "CodeEdge": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
