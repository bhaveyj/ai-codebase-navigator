  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "repositoryId": {
            "type": "string",
            "title": "Repositoryid"
          },
          "repositoryName": {
            "type": "string",
